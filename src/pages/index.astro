---
import { getOrderedProjects } from '@/lib/projects';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '@/layouts/BaseLayout.astro';
import siteConfig from '@/site.config';
import { withBase } from '@/lib/url';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import AboutSlideshow from '@/components/home/AboutSlideshow.astro';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import GlassCard from '@/components/ui/GlassCard.astro';
import Picture from '@/components/ui/Picture.astro';

// All projects, not just `featured`, in the order set in src/lib/projects.ts.
const projects = await getOrderedProjects();

const RESUME = '/resume/Raphael_Larroquette_Resume.pdf';
// Generated at deploy time by scripts/build-pdf.mjs (not present under npm run dev)
const PORTFOLIO = '/Raphael_Larroquette_Portfolio.pdf';
const resumeExists = existsSync(
  join(process.cwd(), 'public', 'resume', 'Raphael_Larroquette_Resume.pdf'),
);

const icon = (paths: string) =>
  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;
const icons = {
  pdf: icon(
    '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M9 15h6"/><path d="M9 18h4"/>',
  ),
  email: icon(
    '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/>',
  ),
  linkedin: icon(
    '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>',
  ),
  github: icon(
    '<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>',
  ),
  phone: icon(
    '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>',
  ),
};

const contactLinks = [
  {
    label: 'Email',
    text: 'r.larroquette@mail.utoronto.ca',
    href: 'mailto:r.larroquette@mail.utoronto.ca',
    icon: icons.email,
    external: false,
  },
  {
    label: 'LinkedIn',
    text: 'linkedin.com/in/raphael-larroquette',
    href: 'https://linkedin.com/in/raphael-larroquette',
    icon: icons.linkedin,
    external: true,
  },
  {
    label: 'GitHub',
    text: 'github.com/Raphael-Larroquette',
    href: 'https://github.com/Raphael-Larroquette',
    icon: icons.github,
    external: true,
  },
  {
    label: 'Phone',
    text: '+1 437-286-8177',
    href: 'tel:+14372868177',
    icon: icons.phone,
    external: false,
  },
];
---

<BaseLayout
  title="Raphael Larroquette Engineering Portfolio"
  description={siteConfig.description}
>
  <Header />

  <main id="main" tabindex="-1">
    <section class="home-hero">
      <Container size="xl">
        <h1>Raphael Larroquette Engineering Portfolio</h1>
        <div class="home-hero__actions">
          <Button href="#projects" variant="solid" size="lg"
            >View Projects</Button
          >
          {
            resumeExists && (
              <Button
                href={withBase(RESUME)}
                variant="outline"
                size="lg"
                download="Raphael_Larroquette_Resume.pdf"
              >
                Download Resume
              </Button>
            )
          }
          <Button
            href={withBase(PORTFOLIO)}
            variant="outline"
            size="lg"
            download="Raphael_Larroquette_Portfolio.pdf"
          >
            Download Portfolio (PDF)
          </Button>
        </div>
      </Container>
    </section>

    <section class="home-section" id="about">
      <Container size="xl">
        <div class="about">
          <div class="about__text">
            <h2>Who am I</h2>
            <p>
              I'm a Mechanical Engineering student at the University of Toronto
              and Mechanical Lead at Blue Sky Solar Racing, where I design
              suspension, drivetrain and braking systems for our solar car. I
              also work on liquid propulsion with the UofT Aerospace Team and do
              materials research at MCML. I like building the tools that make
              the next design better, whether that's hand calcs, CAD and FEA, or
              software when the existing tools fall short.
            </p>
          </div>
          <AboutSlideshow />
        </div>
      </Container>
    </section>

    <section class="home-section" id="projects">
      <Container size="xl">
        <h2>Projects</h2>
        <div class="project-grid">
          {
            projects.map((project) => (
              <GlassCard
                href={withBase(`/work/${project.id}/`)}
                padding="none"
                radius="xl"
                class="pcard"
              >
                <div class="pcard__image">
                  <Picture
                    src={project.data.cover}
                    alt={project.data.coverAlt ?? project.data.title}
                    widths={[400, 800, 1200]}
                    sizes="(min-width: 640px) 48vw, 100vw"
                    loading="lazy"
                  />
                </div>
                <div class="pcard__body">
                  <h3>{project.data.title}</h3>
                  <p>{project.data.summary}</p>
                </div>
              </GlassCard>
            ))
          }
        </div>
      </Container>
    </section>

    <section class="home-section" id="contact">
      <Container size="xl">
        <div class:list={['contact', { 'contact--solo': !resumeExists }]}>
          {
            resumeExists && (
              <div class="resume">
                <h2>Resume</h2>
                <a
                  class="resume__file"
                  href={withBase(RESUME)}
                  download="Raphael_Larroquette_Resume.pdf"
                >
                  <span class="resume__icon" set:html={icons.pdf} />
                  <span>Raphael_Larroquette_Resume.pdf</span>
                </a>
                <div class="resume__actions">
                  <Button
                    href={withBase(RESUME)}
                    variant="solid"
                    download="Raphael_Larroquette_Resume.pdf"
                  >
                    Download Resume
                  </Button>
                  <Button
                    href={withBase(PORTFOLIO)}
                    variant="outline"
                    download="Raphael_Larroquette_Portfolio.pdf"
                  >
                    Download Portfolio (PDF)
                  </Button>
                </div>
              </div>
            )
          }

          <div class="connect">
            <h2>Let's connect</h2>
            <p>Available for internships starting May 2027.</p>
            <ul class="connect__list">
              {
                contactLinks.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target={link.external ? '_blank' : undefined}
                      rel={link.external ? 'noopener' : undefined}
                    >
                      <span class="connect__icon" set:html={link.icon} />
                      <span>
                        <small>{link.label}</small>
                        {link.text}
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </Container>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  main {
    overflow: clip;
  }

  /* Anchored sections stop below the sticky header. */
  :global(html) {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }

  .home-section {
    scroll-margin-top: 5rem;
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .home-section h2 {
    margin: 0 0 var(--space-xl);
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: -0.04em;
  }

  .home-hero {
    display: grid;
    align-items: center;
    min-height: min(36rem, calc(100dvh - 5rem));
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  .home-hero h1 {
    max-width: 16ch;
    margin: 0 0 var(--space-2xl);
    font-size: clamp(3rem, 8vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  /* ---------- about ---------- */

  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .about__text p {
    max-width: 38rem;
    margin: 0;
    color: var(--color-text);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  /* ---------- projects ---------- */

  /* 2 across: the four live projects form a 2x2 with no orphan card */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl);
  }

  .project-grid :global(.pcard) {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    text-decoration: none;
  }

  .pcard__image {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-surface);
  }

  /* <picture> is inline by default, so the img's height: 100% had nothing to
     fill and covers that aren't 16:10 left a band under the image */
  .pcard__image :global(picture) {
    display: block;
    height: 100%;
  }

  .pcard__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @media (hover: hover) {
    .project-grid :global(.pcard:hover) .pcard__image :global(img) {
      transform: scale(1.035);
    }
  }

  .pcard__body {
    padding: var(--space-lg) var(--space-xl) var(--space-xl);
  }

  .pcard__body h3 {
    margin: 0 0 var(--space-sm);
    font-size: var(--text-xl);
    line-height: 1.15;
  }

  .pcard__body p {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* ---------- resume + contact ---------- */

  .contact {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .contact--solo {
    grid-template-columns: minmax(0, 1fr);
  }

  .resume {
    display: grid;
    gap: var(--space-lg);
    justify-items: start;
  }

  .resume__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .resume h2,
  .connect h2 {
    margin-bottom: 0;
  }

  .resume__file {
    display: inline-flex;
    gap: var(--space-md);
    align-items: center;
    color: var(--color-text);
    text-decoration: none;
  }

  .resume__icon,
  .connect__icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 2.75rem;
    aspect-ratio: 1;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    background: var(--color-accent-glass);
    color: var(--color-accent);
  }

  .connect > p {
    margin: var(--space-md) 0 var(--space-lg);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .connect__list {
    display: grid;
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .connect__list a {
    display: inline-flex;
    gap: var(--space-md);
    align-items: center;
    color: var(--color-text);
    text-decoration: none;
  }

  .connect__list a:hover span:last-child {
    color: var(--color-accent);
  }

  .connect__list small {
    display: block;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .about,
    .contact {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pcard__image :global(img) {
      transition: none;
    }
  }
</style>
